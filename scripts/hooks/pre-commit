#!/usr/bin/env bash
# Local secret guard. Installed automatically by `npm install` (package.json
# "prepare" sets core.hooksPath=scripts/hooks). CI runs the same checks over the
# full history, so `git commit --no-verify` only moves the failure to CI —
# by which point a pushed branch is already public. Do not bypass.
set -euo pipefail
root="$(git rev-parse --show-toplevel)"

"$root/scripts/check-forbidden-files.sh" --staged

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed — refusing to commit unscanned." >&2
  echo "  install: https://github.com/gitleaks/gitleaks#installing (brew install gitleaks / release binary)" >&2
  exit 1
fi

gitleaks git --pre-commit --staged --no-banner --redact --verbose \
  --config "$root/.gitleaks.toml" \
  --gitleaks-ignore-path "$root/.gitleaksignore" \
  "$root"
